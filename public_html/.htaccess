# -------------------------------------------------
# Activar mod_rewrite
# -------------------------------------------------
RewriteEngine On

# Redirigir www a no-www
RewriteCond %{HTTP_HOST} ^www\.stamerica\.com [NC]
RewriteRule ^(.*)$ https://stamerica.com/$1 [L,R=301,NE]

# -------------------------------------------------
# Protección de archivos sensibles
# -------------------------------------------------
<FilesMatch "(\.env|\.htaccess|composer\.json|composer\.lock|artisan)">
    Require all denied
</FilesMatch>

# -------------------------------------------------
# Evitar ejecución de PHP en storage
# -------------------------------------------------
# Opcional: crea un .htaccess dentro de /storage con esto
# <FilesMatch "\.php$">
#     Require all denied
# </FilesMatch>

# Bloquear acceso directo a controladores o rutas internas
<FilesMatch ".*Controller\.php$">
    Require all denied
</FilesMatch>

# -------------------------------------------------
# Reescribir URLs a index.php para el framework
# -------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]

# -------------------------------------------------
# Compresión de salida
# -------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
    AddOutputFilterByType DEFLATE application/font-woff application/font-woff2 font/ttf font/otf application/vnd.ms-fontobject

    # Excluir navegadores antiguos
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# -------------------------------------------------
# Control de expiración de recursos
# -------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
</IfModule>

# -------------------------------------------------
# PHP handler (ajustar según versión del hosting)
# -------------------------------------------------
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
